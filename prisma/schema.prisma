generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utente {
  id                  Int      @id @default(autoincrement())
  nome                String
  cognome             String
  passwordHash        String?  @map("password_hash")
  ruolo               Ruolo    @default(DIPENDENTE)
  attivo              Boolean  @default(true)
  abilitatoBollettini Boolean  @default(false) @map("abilitato_bollettini")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  attivita           Attivita[]                @relation("UtenteAttivita")
  attivitaCreate     Attivita[]                @relation("CreatoDa")
  bollettini         Bollettino[]              @relation("UtenteBollettini")
  allegatiBollettino AllegatoBollettino[]      @relation("UtenteAllegatiBollettino")
  collaborazioni     BollettinoCollaboratore[]

  @@map("utenti")
}

enum Ruolo {
  DIPENDENTE
  RESPONSABILE
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cantieri   Cantiere[]
  attivita   Attivita[]
  eventi     CalendarioEvento[]
  bollettini Bollettino[]

  @@map("clienti")
}

model Cantiere {
  id         Int      @id @default(autoincrement())
  clienteId  Int      @map("cliente_id")
  nome       String
  isGenerico Boolean  @default(false) @map("is_generico")
  attivo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cliente         Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  attivita        Attivita[]
  bollettini      Bollettino[]
  bollettiniMulti BollettinoCantiere[]

  @@map("cantieri")
}

model TipoAttivita {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attivita Attivita[]

  @@map("tipi_attivita")
}

model TipoAssenza {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attivita Attivita[]

  @@map("tipi_assenza")
}

model Attivita {
  id                  Int      @id @default(autoincrement())
  utenteId            Int      @map("utente_id")
  dataRiferimento     DateTime @map("data_riferimento") @db.Date
  oraInizioMattino    String?  @map("ora_inizio_mattino")
  oraFineMattino      String?  @map("ora_fine_mattino")
  oraInizioPomeriggio String?  @map("ora_inizio_pomeriggio")
  oraFinePomeriggio   String?  @map("ora_fine_pomeriggio")
  durataMinuti        Int      @map("durata_minuti")
  clienteId           Int?     @map("cliente_id")
  cantiereId          Int?     @map("cantiere_id")
  tipoAttivitaId      Int?     @map("tipo_attivita_id")
  assenzaId           Int?     @map("assenza_id")
  note                String?
  createdById         Int      @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  utente       Utente        @relation("UtenteAttivita", fields: [utenteId], references: [id])
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  cantiere     Cantiere?     @relation(fields: [cantiereId], references: [id])
  tipoAttivita TipoAttivita? @relation(fields: [tipoAttivitaId], references: [id])
  assenza      TipoAssenza?  @relation(fields: [assenzaId], references: [id])
  createdBy    Utente        @relation("CreatoDa", fields: [createdById], references: [id])

  @@map("attivita")
}

/// Eventi del calendario annuale: durata dell'evento piu' le date opzionali
/// di consegna e smontaggio, che possono cadere in un anno diverso.
/// Le date sono @db.Date perche' contano i giorni, non gli istanti.
model CalendarioEvento {
  id             Int       @id @default(autoincrement())
  clienteId      Int       @map("cliente_id")
  nome           String?
  dataInizio     DateTime  @map("data_inizio") @db.Date
  dataFine       DateTime  @map("data_fine") @db.Date
  dataConsegna   DateTime? @map("data_consegna") @db.Date
  dataSmontaggio DateTime? @map("data_smontaggio") @db.Date
  importo        Float?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([dataInizio])
  @@index([clienteId])
  @@map("calendario_eventi")
}

enum QuotaNoleggio {
  SETTANTA_TRENTA
  CENTO
}

model DreamVeicolo {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  noleggi         DreamNoleggio[]
  noleggiGica     GicaNoleggio[]
  righeBollettino RigaBollettino[]

  @@map("dream_veicoli")
}

/// Anagrafica separata da `clienti`: i clienti del noleggio Dream sono un
/// insieme diverso da quelli dei cantieri, non un sottoinsieme.
model DreamCliente {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  noleggi     DreamNoleggio[]
  noleggiGica GicaNoleggio[]

  @@map("dream_clienti")
}

/// Veicolo e cliente si disattivano e non si cancellano, quindi le relazioni
/// non hanno bisogno di onDelete. `importoCalcolato` e' persistito e non
/// ricalcolato in lettura: il report somma una colonna esistente e uno storico
/// non cambia se un giorno cambia la percentuale.
model DreamNoleggio {
  id               Int           @id @default(autoincrement())
  veicoloId        Int           @map("veicolo_id")
  clienteId        Int?          @map("cliente_id")
  data             DateTime      @db.Date
  osservazioni     String?       @db.Text
  importo          Float
  quota            QuotaNoleggio
  importoCalcolato Float         @map("importo_calcolato")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  veicolo DreamVeicolo  @relation(fields: [veicoloId], references: [id])
  cliente DreamCliente? @relation(fields: [clienteId], references: [id])

  @@index([data])
  @@map("dream_noleggi")
}

/// Registro Gica: stessa anagrafica del noleggio Dream (veicoli e clienti sono
/// condivisi) ma senza quota, quindi senza importo calcolato.
model GicaNoleggio {
  id           Int      @id @default(autoincrement())
  veicoloId    Int      @map("veicolo_id")
  clienteId    Int?     @map("cliente_id")
  data         DateTime @db.Date
  osservazioni String?  @db.Text
  importo      Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  veicolo DreamVeicolo  @relation(fields: [veicoloId], references: [id])
  cliente DreamCliente? @relation(fields: [clienteId], references: [id])

  @@index([data])
  @@map("gica_noleggi")
}

model BackupLog {
  id         Int         @id @default(autoincrement())
  filename   String
  tipo       TipoBackup
  dimensione Int
  stato      StatoBackup
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("backup_logs")
}

enum TipoBackup {
  AUTOMATICO
  MANUALE
}

enum StatoBackup {
  COMPLETATO
  ERRORE
  IN_CORSO
}

model TipoAttributoExtra {
  id        Int      @id @default(autoincrement())
  nome      String
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  valori ValoreAttributoExtra[]

  @@map("tipi_attributo_extra")
}

model ValoreAttributoExtra {
  id                   Int      @id @default(autoincrement())
  tipoAttributoExtraId Int      @map("tipo_attributo_extra_id")
  valore               String
  attivo               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")

  tipoAttributoExtra TipoAttributoExtra @relation(fields: [tipoAttributoExtraId], references: [id], onDelete: Cascade)

  @@map("valori_attributo_extra")
}

model Configurazione {
  id     Int    @id @default(autoincrement())
  chiave String @unique
  valore String

  @@map("configurazioni")
}

enum TipoVoce {
  MEZZO
  MATERIALE
  TRASPORTO
}

model VoceBollettino {
  id        Int      @id @default(autoincrement())
  tipo      TipoVoce
  nome      String
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  righe RigaBollettino[]

  @@unique([tipo, nome])
  @@index([tipo, attivo])
  @@map("voci_bollettino")
}

model Bollettino {
  id              Int      @id @default(autoincrement())
  utenteId        Int      @map("utente_id")
  // Entrambi facoltativi, ma non insieme: come per le attivita', il cantiere
  // e' obbligatorio solo se il cliente ne ha almeno uno attivo. I bollettini
  // creati prima di questa modifica hanno cliente_id NULL e restano
  // raggiungibili dal cliente solo attraverso il cantiere.
  clienteId       Int?     @map("cliente_id")
  cantiereId      Int?     @map("cantiere_id")
  dataRiferimento DateTime @map("data_riferimento") @db.Date
  attivita        String   @db.Text
  numeroOperai    Int      @default(0) @map("numero_operai")
  // Ore per singolo operaio: il totale ore-uomo e' numeroOperai * ore.
  // Nei bollettini con le ore per collaboratore vale 0 e conta `oreTotali`
  ore             Float    @default(0)
  // Somma delle ore dei collaboratori. NULL nei bollettini precedenti, per i
  // quali il totale resta numeroOperai * ore
  oreTotali       Float?   @map("ore_totali")

  // Fasce orarie della giornata, come nelle attivita' (HH:mm). NULL nei
  // bollettini precedenti
  oraInizioMattino    String? @map("ora_inizio_mattino")
  oraFineMattino      String? @map("ora_fine_mattino")
  oraInizioPomeriggio String? @map("ora_inizio_pomeriggio")
  oraFinePomeriggio   String? @map("ora_fine_pomeriggio")

  // Materiali come testo libero. NULL nei bollettini precedenti, che hanno
  // i materiali come righe di tipo MATERIALE
  materialiTesto String? @map("materiali_testo") @db.Text

  // Copia dei nomi al momento della firma: il documento non deve cambiare
  // se cliente o cantiere vengono rinominati in seguito
  clienteNome  String  @map("cliente_nome")
  cantiereNome String? @map("cantiere_nome")

  firmaOperatoreNome   String @map("firma_operatore_nome")
  firmaOperatoreImg    String @map("firma_operatore_img") @db.Text
  firmaCommittenteNome String @map("firma_committente_nome")
  firmaCommittenteImg  String @map("firma_committente_img") @db.Text

  // Invio del PDF al committente. Tutto nullable: il bollettino esiste anche
  // senza mail, e la mail non deve mai poterne impedire il salvataggio.
  // Viene conservato solo l'ultimo tentativo, non lo storico.
  emailDestinatario String?   @map("email_destinatario")
  emailStato        String?   @map("email_stato")
  emailInviataAt    DateTime? @map("email_inviata_at")
  emailMessageId    String?   @map("email_message_id")
  emailErrore       String?   @map("email_errore") @db.Text

  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  utente        Utente                    @relation("UtenteBollettini", fields: [utenteId], references: [id])
  cliente       Cliente?                  @relation(fields: [clienteId], references: [id])
  cantiere      Cantiere?                 @relation(fields: [cantiereId], references: [id])
  righe         RigaBollettino[]
  allegati      AllegatoBollettino[]
  // Selezione multipla. `cantiereId` e `cantiereNome` restano valorizzati
  // (primo cantiere e nomi uniti da virgola): elenco, mail, nome del PDF e i
  // bollettini precedenti alla selezione multipla continuano a leggere quelli
  cantieri      BollettinoCantiere[]
  collaboratori BollettinoCollaboratore[]
  squadre       BollettinoSquadra[]

  @@index([clienteId, dataRiferimento])
  @@index([cantiereId, dataRiferimento])
  @@index([utenteId, dataRiferimento])
  @@map("bollettini")
}

model RigaBollettino {
  id           Int      @id @default(autoincrement())
  bollettinoId Int      @map("bollettino_id")
  tipo         TipoVoce
  voceId       Int?     @map("voce_id")
  // Solo per i mezzi: veicolo dell'anagrafica Gica Noleggi (dream_veicoli).
  // Le righe mezzo precedenti hanno invece `voceId`.
  veicoloId    Int?     @map("veicolo_id")
  // Copia del nome della voce al momento della firma
  descrizione  String
  // Ore per i mezzi, quantita' per i materiali, viaggi per i trasporti
  quantita     Float    @default(0)

  bollettino Bollettino      @relation(fields: [bollettinoId], references: [id], onDelete: Cascade)
  voce       VoceBollettino? @relation(fields: [voceId], references: [id], onDelete: SetNull)
  veicolo    DreamVeicolo?   @relation(fields: [veicoloId], references: [id], onDelete: SetNull)

  @@index([bollettinoId, tipo])
  @@map("righe_bollettino")
}

/// Cantieri del bollettino, tutti dello stesso cliente. Il nome e' copiato
/// alla firma, come per le righe.
model BollettinoCantiere {
  id           Int    @id @default(autoincrement())
  bollettinoId Int    @map("bollettino_id")
  cantiereId   Int?   @map("cantiere_id")
  nome         String

  bollettino Bollettino @relation(fields: [bollettinoId], references: [id], onDelete: Cascade)
  cantiere   Cantiere?  @relation(fields: [cantiereId], references: [id], onDelete: SetNull)

  @@index([bollettinoId])
  @@index([cantiereId])
  @@map("bollettini_cantieri")
}

/// Gruppi di operai con gli stessi orari: "3 operai 07-12 / 13-17". Le ore
/// della riga (operai x durata delle fasce) le calcola il server.
model BollettinoSquadra {
  id                  Int     @id @default(autoincrement())
  bollettinoId        Int     @map("bollettino_id")
  numeroOperai        Int     @map("numero_operai")
  oraInizioMattino    String? @map("ora_inizio_mattino")
  oraFineMattino      String? @map("ora_fine_mattino")
  oraInizioPomeriggio String? @map("ora_inizio_pomeriggio")
  oraFinePomeriggio   String? @map("ora_fine_pomeriggio")
  ore                 Float

  bollettino Bollettino @relation(fields: [bollettinoId], references: [id], onDelete: Cascade)

  @@index([bollettinoId])
  @@map("bollettini_squadre")
}

/// Operai presenti sul lavoro, scelti fra gli utenti. `numeroOperai` del
/// bollettino e' il loro conteggio. Nome copiato alla firma.
model BollettinoCollaboratore {
  id           Int    @id @default(autoincrement())
  bollettinoId Int    @map("bollettino_id")
  utenteId     Int?   @map("utente_id")
  nome         String
  // Ore lavorate da questo collaboratore. NULL nelle righe salvate prima
  // delle ore per collaboratore
  ore          Float?

  bollettino Bollettino @relation(fields: [bollettinoId], references: [id], onDelete: Cascade)
  utente     Utente?    @relation(fields: [utenteId], references: [id], onDelete: SetNull)

  @@index([bollettinoId])
  @@index([utenteId])
  @@map("bollettini_collaboratori")
}

// Foto e PDF allegati al bollettino. In tabella stanno i soli metadati: i byte
// vivono su R2, nello stesso bucket dei backup sotto il prefisso `allegati/`.
// Una foto da telefono pesa due ordini di grandezza piu' di una firma base64, e
// il dump notturno del backup legge i bollettini senza `select`.
model AllegatoBollettino {
  id           Int      @id @default(autoincrement())
  // NULL fra l'upload e il salvataggio: il file si carica prima delle firme,
  // e finche' il bollettino non esiste l'allegato non ha padre.
  bollettinoId Int?     @map("bollettino_id")
  // Serve a sapere di chi e' un allegato ancora orfano: solo chi l'ha caricato
  // puo' collegarlo o cancellarlo.
  caricatoDaId Int      @map("caricato_da")
  chiave       String   @unique
  nomeFile     String   @map("nome_file")
  mimeType     String   @map("mime_type")
  dimensione   Int
  createdAt    DateTime @default(now()) @map("created_at")

  bollettino Bollettino? @relation(fields: [bollettinoId], references: [id], onDelete: Cascade)
  caricatoDa Utente      @relation("UtenteAllegatiBollettino", fields: [caricatoDaId], references: [id])

  @@index([bollettinoId])
  // Usato dalla pulizia notturna degli orfani
  @@index([createdAt])
  @@map("allegati_bollettino")
}
