generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utente {
  id                  Int      @id @default(autoincrement())
  nome                String
  cognome             String
  passwordHash        String?  @map("password_hash")
  ruolo               Ruolo    @default(DIPENDENTE)
  attivo              Boolean  @default(true)
  abilitatoBollettini Boolean  @default(false) @map("abilitato_bollettini")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  attivita       Attivita[] @relation("UtenteAttivita")
  attivitaCreate Attivita[] @relation("CreatoDa")
  bollettini     Bollettino[] @relation("UtenteBollettini")

  @@map("utenti")
}

enum Ruolo {
  DIPENDENTE
  RESPONSABILE
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cantieri Cantiere[]
  attivita Attivita[]
  eventi   CalendarioEvento[]

  @@map("clienti")
}

model Cantiere {
  id         Int      @id @default(autoincrement())
  clienteId  Int      @map("cliente_id")
  nome       String
  isGenerico Boolean  @default(false) @map("is_generico")
  attivo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  attivita     Attivita[]
  bollettini   Bollettino[]

  @@map("cantieri")
}

model TipoAttivita {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attivita Attivita[]

  @@map("tipi_attivita")
}

model TipoAssenza {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attivita Attivita[]

  @@map("tipi_assenza")
}

model Attivita {
  id                   Int      @id @default(autoincrement())
  utenteId             Int      @map("utente_id")
  dataRiferimento      DateTime @map("data_riferimento") @db.Date
  oraInizioMattino     String?  @map("ora_inizio_mattino")
  oraFineMattino       String?  @map("ora_fine_mattino")
  oraInizioPomeriggio  String?  @map("ora_inizio_pomeriggio")
  oraFinePomeriggio    String?  @map("ora_fine_pomeriggio")
  durataMinuti         Int      @map("durata_minuti")
  clienteId            Int?     @map("cliente_id")
  cantiereId           Int?     @map("cantiere_id")
  tipoAttivitaId       Int?     @map("tipo_attivita_id")
  assenzaId            Int?     @map("assenza_id")
  note                 String?
  createdById          Int      @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  utente       Utente       @relation("UtenteAttivita", fields: [utenteId], references: [id])
  cliente      Cliente?     @relation(fields: [clienteId], references: [id])
  cantiere     Cantiere?    @relation(fields: [cantiereId], references: [id])
  tipoAttivita TipoAttivita? @relation(fields: [tipoAttivitaId], references: [id])
  assenza      TipoAssenza? @relation(fields: [assenzaId], references: [id])
  createdBy    Utente       @relation("CreatoDa", fields: [createdById], references: [id])

  @@map("attivita")
}

/// Eventi del calendario annuale: durata dell'evento piu' le date opzionali
/// di consegna e smontaggio, che possono cadere in un anno diverso.
/// Le date sono @db.Date perche' contano i giorni, non gli istanti.
model CalendarioEvento {
  id             Int       @id @default(autoincrement())
  clienteId      Int       @map("cliente_id")
  nome           String?
  dataInizio     DateTime  @map("data_inizio")     @db.Date
  dataFine       DateTime  @map("data_fine")       @db.Date
  dataConsegna   DateTime? @map("data_consegna")   @db.Date
  dataSmontaggio DateTime? @map("data_smontaggio") @db.Date
  importo        Float?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([dataInizio])
  @@index([clienteId])
  @@map("calendario_eventi")
}

model BackupLog {
  id         Int         @id @default(autoincrement())
  filename   String
  tipo       TipoBackup
  dimensione Int
  stato      StatoBackup
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("backup_logs")
}

enum TipoBackup {
  AUTOMATICO
  MANUALE
}

enum StatoBackup {
  COMPLETATO
  ERRORE
  IN_CORSO
}

model TipoAttributoExtra {
  id        Int      @id @default(autoincrement())
  nome      String
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  valori ValoreAttributoExtra[]

  @@map("tipi_attributo_extra")
}

model ValoreAttributoExtra {
  id                   Int      @id @default(autoincrement())
  tipoAttributoExtraId Int      @map("tipo_attributo_extra_id")
  valore               String
  attivo               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")

  tipoAttributoExtra TipoAttributoExtra @relation(fields: [tipoAttributoExtraId], references: [id], onDelete: Cascade)

  @@map("valori_attributo_extra")
}

model Configurazione {
  id     Int    @id @default(autoincrement())
  chiave String @unique
  valore String

  @@map("configurazioni")
}

enum TipoVoce {
  MEZZO
  MATERIALE
  TRASPORTO
}

model VoceBollettino {
  id        Int      @id @default(autoincrement())
  tipo      TipoVoce
  nome      String
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  righe RigaBollettino[]

  @@unique([tipo, nome])
  @@index([tipo, attivo])
  @@map("voci_bollettino")
}

model Bollettino {
  id              Int      @id @default(autoincrement())
  utenteId        Int      @map("utente_id")
  cantiereId      Int      @map("cantiere_id")
  dataRiferimento DateTime @map("data_riferimento") @db.Date
  attivita        String   @db.Text
  numeroOperai    Int      @default(0) @map("numero_operai")
  // Ore per singolo operaio: il totale ore-uomo e' numeroOperai * ore
  ore             Float    @default(0)

  // Copia dei nomi al momento della firma: il documento non deve cambiare
  // se cliente o cantiere vengono rinominati in seguito
  clienteNome  String @map("cliente_nome")
  cantiereNome String @map("cantiere_nome")

  firmaOperatoreNome   String @map("firma_operatore_nome")
  firmaOperatoreImg    String @map("firma_operatore_img")   @db.Text
  firmaCommittenteNome String @map("firma_committente_nome")
  firmaCommittenteImg  String @map("firma_committente_img") @db.Text

  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  utente   Utente   @relation("UtenteBollettini", fields: [utenteId], references: [id])
  cantiere Cantiere @relation(fields: [cantiereId], references: [id])
  righe    RigaBollettino[]

  @@index([cantiereId, dataRiferimento])
  @@index([utenteId, dataRiferimento])
  @@map("bollettini")
}

model RigaBollettino {
  id           Int      @id @default(autoincrement())
  bollettinoId Int      @map("bollettino_id")
  tipo         TipoVoce
  voceId       Int?     @map("voce_id")
  // Copia del nome della voce al momento della firma
  descrizione  String
  // Ore per i mezzi, quantita' per i materiali, viaggi per i trasporti
  quantita     Float    @default(0)

  bollettino Bollettino      @relation(fields: [bollettinoId], references: [id], onDelete: Cascade)
  voce       VoceBollettino? @relation(fields: [voceId], references: [id], onDelete: SetNull)

  @@index([bollettinoId, tipo])
  @@map("righe_bollettino")
}
